      ],
      "id": "b2000001-0000-4000-8000-000000000003",
      "name": "Responder 202",
      "notes": "202 sólo confirma recepción del trabajo por n8n. PHP mantiene el transporte pendiente hasta el callback accepted o failed del proveedor."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (!$json.valid || !$json.notification) return null;\nconst n = $json.notification;\nconst r = n.reservation;\nconst d = n.data;\nconst values = [n.recipient.name, r.date, r.time, d.management_url];\nreturn { json: { ...n, email_subject: 'Necesitamos ajustar tu reservación', email_text: `Hola ${n.recipient.name},\\n\\nUn cambio en nuestro horario afecta tu reservación del ${r.date} a las ${r.time}.\\n\\nElige otro horario o cancela tu reservación aquí:\\n${d.management_url}\\n\\nEste acceso vence el ${d.access_expires_at}.`, whatsapp_template: 'reservation_schedule_change', whatsapp_components: { component: [{ type: 'body', bodyParameters: { parameter: values.map((value) => ({ type: 'text', text: String(value) })) } }] } } };"
      },
      "type": "n8n-nodes-base.code",
