    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const n = $json || {};\nconst contact = n.contact || {};\nconst recipient = n.recipient || {};\nconst reservation = n.reservation || {};\nconst data = n.data || {};\nconst transport = n.transport || {};\nif (contact.type !== 'whatsapp') return null;\nconst mode = String(transport.whatsapp_mode || '');\nif (!['text', 'template'].includes(mode)) return null;\nconst name = String(recipient.name || 'Cliente');\nconst management = data.management_url ? `\\n\\nElige otro horario o cancela tu reservación aquí:\\n${data.management_url}` : '';\nconst expiry = data.access_expires_at ? `\\n\\nEste acceso vence el ${data.access_expires_at}.` : '';\nconst text = `Hola ${name},\\n\\nUn cambio en nuestro horario afecta tu reservación del ${reservation.date} a las ${reservation.time}.${management}${expiry}`;\nreturn { json: { schema_version: n.schema_version, event: n.event, source_id: n.source_id, reservation_id: n.reservation_id, attempt: n.attempt, channel: 'whatsapp', mode, to: String(contact.value || ''), text, template: String(n.whatsapp_template || ''), components: n.whatsapp_components || {}, purpose: String(data.purpose || '') } };"
      },
