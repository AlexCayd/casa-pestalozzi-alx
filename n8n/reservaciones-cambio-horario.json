    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || {};\nconst positive = (value) => Number.isInteger(Number(value)) && Number(value) > 0;\nconst c = body.contact || {};\nconst r = body.reservation || {};\nconst d = body.data || {};\nconst t = body.transport || {};\nconst validContact = c.type === 'email' ? /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(c.value || '')) : c.type === 'whatsapp' ? /^\\+52\\d{10}$/.test(String(c.value || '')) : false;\nconst validMode = ['text', 'template'].includes(String(t.whatsapp_mode || ''));\nconst valid = Number(body.schema_version) === 1 && body.event === 'reservation.schedule_change' && positive(body.source_id) && positive(body.reservation_id) && [1, 2].includes(Number(body.attempt)) && validContact && validMode && body.recipient && String(body.recipient.name || '').trim() !== '' && /^\\d{4}-\\d{2}-\\d{2}$/.test(String(r.date || '')) && /^\\d{2}:\\d{2}$/.test(String(r.time || '')) && positive(r.guests) && /^https?:\\/\\/[^\\s]+$/i.test(String(d.management_url || '')) && !Number.isNaN(Date.parse(String(d.access_expires_at || '')));\nreturn { json: { valid: Boolean(valid), notification: valid ? body : null } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -700,
        0
      ],
      "id": "b2000001-0000-4000-8000-000000000002",
