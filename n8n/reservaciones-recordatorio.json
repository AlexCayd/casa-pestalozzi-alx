        "mode": "runOnceForEachItem",
        "jsCode": "const n = $json || {};\nconst contact = n.contact || {};\nconst data = n.data || {};\nif (contact.type !== 'email') return null;\nreturn { json: { schema_version: n.schema_version, event: n.event, source_id: n.source_id, reservation_id: n.reservation_id, attempt: n.attempt, channel: 'email', to: String(contact.value || ''), subject: String(n.email_subject || ''), message: String(n.email_text || ''), purpose: String(data.purpose || '') } };"
