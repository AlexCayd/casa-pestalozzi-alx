        "jsCode": "const n = $('Preparar recordatorio').item.json;\nconst error = $json.error || {};\nconst http = Number(error.httpCode || error.statusCode || 0);\nconst smtp = Number(error.responseCode || 0);\n// Sólo rechazo inequívoco. Timeout/conexión perdida/5xx pueden ser ambiguos.\nconst retryable = (http >= 400 && http < 500 && http !== 408) || smtp >= 500;\nreturn { json: { event: n.event, source_id: n.source_id, attempt: n.attempt, channel: 'email', status: 'failed', retryable } };"
