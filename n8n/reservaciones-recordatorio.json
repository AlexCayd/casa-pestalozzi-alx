    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const n = $json;\nconst r = n.reservation;\nconst d = n.data;\nconst values = [n.recipient.name, r.date, r.time, r.guests, d.management_url];\nreturn { json: { ...n, email_subject: 'Tu reservación es mañana', email_text: `Hola ${n.recipient.name},\\n\\nTe esperamos mañana en Casa Pestalozzi.\\n\\n${r.date} a las ${r.time} · ${r.guests} personas\\n\\nPuedes revisar, modificar o cancelar tu reservación aquí:\\n${d.management_url}\\n\\nEste acceso vence el ${d.access_expires_at}.`, whatsapp_template: 'reservation_reminder', whatsapp_components: { component: [{ type: 'body', bodyParameters: { parameter: values.map((value) => ({ type: 'text', text: String(value) })) } }] } } };"
      },
