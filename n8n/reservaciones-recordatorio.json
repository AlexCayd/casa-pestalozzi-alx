    {
      "parameters": {
        "jsCode": "const input = $input.first().json || {};\nif (input.ok !== true || input.due !== true || input.event !== 'reservation.reminder') return [];\nconst positive = (value) => Number.isInteger(Number(value)) && Number(value) > 0;\nconst valid = (n) => { const c = n && n.contact || {}; const r = n && n.reservation || {}; const d = n && n.data || {}; const t = n && n.transport || {}; const contact = c.type === 'email' ? /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(c.value || '')) : c.type === 'whatsapp' ? /^\\+52\\d{10}$/.test(String(c.value || '')) : false; return n && Number(n.schema_version) === 1 && n.event === 'reservation.reminder' && positive(n.source_id) && positive(n.reservation_id) && [1, 2, 3].includes(Number(n.attempt)) && contact && ['text', 'template'].includes(String(t.whatsapp_mode || '')) && n.recipient && String(n.recipient.name || '').trim() !== '' && /^\\d{4}-\\d{2}-\\d{2}$/.test(String(r.date || '')) && /^\\d{2}:\\d{2}$/.test(String(r.time || '')) && positive(r.guests) && /^https?:\\/\\/[^\\s]+$/i.test(String(d.management_url || '')) && !Number.isNaN(Date.parse(String(d.access_expires_at || ''))); };\nreturn (Array.isArray(input.notifications) ? input.notifications : []).filter(valid).map((notification) => ({ json: notification, pairedItem: { item: 0 } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        0
      ],
