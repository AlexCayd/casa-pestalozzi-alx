# Sólo parámetros no secretos. Copiar FUERA del repositorio al host de destino.
# Valores ilustrativos: no apuntan a la instancia viva ni habilitan producción.
COMPOSE_PROJECT_NAME=casa-n8n-stage6-test
N8N_DATA_VOLUME=casa_n8n_stage6_test_data
N8N_LOCAL_PORT=5678
N8N_HOST=n8n.example.invalid
N8N_EDITOR_BASE_URL=https://n8n.example.invalid/
N8N_WEBHOOK_URL=https://n8n.example.invalid/

# Archivos distintos, generados por el operador y persistentes tras reboot.
# Contienen sólo el valor aleatorio, sin KEY=, comillas, BOM ni espacios.
N8N_ENCRYPTION_KEY_PATH=/etc/casa-n8n/secrets/encryption-key
N8N_RUNNER_AUTH_TOKEN_PATH=/etc/casa-n8n/secrets/runner-auth-token
