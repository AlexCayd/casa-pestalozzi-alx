    {
      "parameters": {
        "jsCode": "const d = $json;\nconst reminder = d.event === 'reservation.reminder_next_day';\nconst title = reminder ? 'Tu reservación es mañana' : 'Necesitamos ajustar tu reservación';\nconst intro = reminder ? 'Te esperamos mañana en Casa Pestalozzi.' : 'Un cambio de horario operativo afecta tu reservación.';\nconst details = `${d.reservation_date} a las ${d.reservation_time} · ${d.guests} ${Number(d.guests) === 1 ? 'persona' : 'personas'}`;\nconst action = reminder ? 'Puedes revisar, modificar o cancelar tu reservación aquí:' : 'Elige un nuevo horario o cancela tu reservación aquí:';\nreturn [{ json: { ...d, email_subject: title, email_text: `${intro}\\n\\n${details}\\n\\n${action}\\n${d.management_url}\\n\\nEste acceso vence el ${d.access_expires_at}.`, phone_text: `${title}. ${details}. ${action} ${d.management_url}` } }];"
      },
      "type": "n8n-nodes-base.code",
