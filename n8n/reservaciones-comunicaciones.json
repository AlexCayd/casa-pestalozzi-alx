    },
    {
      "parameters": {
        "jsCode": "const headers = $json.headers || {};\nconst body = $json.body || {};\nconst supplied = String(headers['x-n8n-secret'] || headers['X-N8N-Secret'] || '');\nconst expected = String($env.N8N_SECRET || '');\nconst authorized = expected.length > 0 && supplied === expected;\nconst allowedEvents = ['reservation.schedule_change', 'reservation.reminder_next_day'];\nconst notifications = Array.isArray(body.notifications) ? body.notifications : [];\nconst valid = Number(body.schema_version) === 1\n  && allowedEvents.includes(String(body.event || ''))\n  && notifications.length > 0\n  && notifications.every((item) => item && Number(item.source_id) > 0 && Number(item.attempt) > 0 && ['email', 'telefono'].includes(String(item.contact_type || '')) && String(item.contact || '') !== '' && String(item.management_url || '') !== '');\nreturn [{ json: { authorized, valid, accepted: authorized && valid, event: body.event, notifications } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-896, -240],
      "id": "d1d1366c-8b32-4bd0-80e0-39c8ad59eaf6",
      "name": "Validar secreto y contrato"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: $json.accepted, accepted: $json.accepted } }}",
        "options": {
          "responseCode": "={{ !$json.authorized ? 403 : ($json.valid ? 202 : 422) }}"
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [-672, -240],
