      "name": "Preparar recordatorios",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "jsCode": "const input = $json || {};\nif (input.accepted === false || input.authorized === false) return [];\nconst event = String(input.event || '');\nconst notifications = Array.isArray(input.notifications) ? input.notifications : [];\nif (!['reservation.schedule_change', 'reservation.reminder_next_day'].includes(event)) return [];\nreturn notifications\n  .filter((item) => item && Number(item.source_id) > 0 && Number(item.attempt) > 0)\n  .map((item) => ({ json: { ...item, event } }));"
      },
      "type": "n8n-nodes-base.code",
