{
  "name": "Reservaciones - Confirmación",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "reservaciones/confirmacion",
        "responseMode": "responseNode",
        "options": {},
        "authentication": "headerAuth"
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -1320,
        0
      ],
      "id": "cf000001-0000-4000-8000-000000000001",
      "name": "Webhook confirmación",
      "webhookId": "cf100001-0000-4000-8000-000000000001",
      "notes": "Asignar en n8n una credencial Header Auth: nombre X-N8N-Secret, valor del secreto PHP → n8n. Usar un secreto distinto para los HTTP Request n8n → PHP. La autenticación nativa ocurre antes de ejecutar el workflow."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || {};\nconst positive = (value) => Number.isInteger(Number(value)) && Number(value) > 0;\nconst contact = body.contact || {};\nconst recipient = body.recipient || {};\nconst reservation = body.reservation;\nconst data = body.data || {};\nconst transport = body.transport || {};\nconst email = typeof contact.value === 'string' && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(contact.value);\nconst whatsapp = typeof contact.value === 'string' && /^\\+52\\d{10}$/.test(contact.value);\nconst validContact = contact.type === 'email' ? email : contact.type === 'whatsapp' ? whatsapp : false;\nconst validMode = ['text', 'template'].includes(String(transport.whatsapp_mode || ''));\nconst validReservation = positive(body.reservation_id) && reservation && /^\\d{4}-\\d{2}-\\d{2}$/.test(String(reservation.date || '')) && /^\\d{2}:\\d{2}$/.test(String(reservation.time || '')) && positive(reservation.guests);\nconst validContactAccess = body.reservation_id === null && reservation === null && data.purpose === 'contact_access';\nconst valid = Number(body.schema_version) === 1 && body.event === 'reservation.confirmation' && positive(body.source_id) && Number(body.attempt) === 1 && validContact && validMode && typeof recipient.name === 'string' && recipient.name.trim() !== '' && /^\\d{6}$/.test(String(data.confirmation_code || '')) && !Number.isNaN(Date.parse(String(data.expires_at || ''))) && (validReservation || validContactAccess);\nreturn { json: { valid: Boolean(valid), notification: valid ? body : null } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        0
      ],
      "id": "cf000001-0000-4000-8000-000000000002",
      "name": "Validar contrato"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (!$json.valid || !$json.notification) return null;\nconst n = $json.notification;\nconst code = String(n.data.confirmation_code);\nreturn { json: { ...n, email_subject: 'Código de confirmación de reservación', email_text: `Hola ${n.recipient.name},\\n\\nTu código de confirmación de Casa Pestalozzi es: ${code}\\n\\nVence el ${n.data.expires_at}.`, whatsapp_template: 'reservation_confirmation_code', whatsapp_components: { component: [{ type: 'body', bodyParameters: { parameter: [{ type: 'text', text: code }] } }] } } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        0
      ],
      "id": "cf000001-0000-4000-8000-000000000004",
      "name": "Preparar confirmación"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3},
                "conditions": [{"id": "cf-email", "leftValue": "={{ $json.contact.type }}", "rightValue": "email", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "email"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3},
                "conditions": [{"id": "cf-whatsapp", "leftValue": "={{ $json.contact.type }}", "rightValue": "whatsapp", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "whatsapp"
            }
          ]
        },
        "looseTypeValidation": false,
        "options": {}
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [0, 0],
      "id": "cf000001-0000-4000-8000-000000000005",
      "name": "Switch channel"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const n = $json || {};\nconst contact = n.contact || {};\nconst data = n.data || {};\nif (contact.type !== 'email') return null;\nreturn { json: { schema_version: n.schema_version, event: n.event, source_id: n.source_id, reservation_id: n.reservation_id, attempt: n.attempt, channel: 'email', to: String(contact.value || ''), subject: String(n.email_subject || ''), message: String(n.email_text || ''), purpose: String(data.purpose || '') } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        -140
      ],
      "id": "cf000001-0000-4000-8000-000000000008",
      "name": "Normalizar Email"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const n = $json || {};\nconst contact = n.contact || {};\nconst data = n.data || {};\nconst recipient = n.recipient || {};\nconst transport = n.transport || {};\nif (contact.type !== 'whatsapp') return null;\nconst mode = String(transport.whatsapp_mode || '');\nif (!['text', 'template'].includes(mode)) return null;\nconst purpose = String(data.purpose || '');\nconst name = String(recipient.name || 'Cliente');\nconst code = String(data.confirmation_code || '');\nconst expiry = data.expires_at ? `\\n\\nVence el ${data.expires_at}.` : '';\nconst text = purpose === 'contact_access'\n  ? `Hola ${name},\\n\\nTu código de acceso a Mis reservaciones es: ${code}.\\n\\nÚsalo para consultar y gestionar tus reservaciones.${expiry}`\n  : `Hola ${name},\\n\\nTu código de confirmación de Casa Pestalozzi es: ${code}.\\n\\nÚsalo para confirmar tu reservación.${expiry}`;\nreturn { json: { schema_version: n.schema_version, event: n.event, source_id: n.source_id, reservation_id: n.reservation_id, attempt: n.attempt, channel: 'whatsapp', mode, to: String(contact.value || ''), text, template: String(n.whatsapp_template || ''), components: n.whatsapp_components || {}, purpose } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        140
      ],
      "id": "cf000001-0000-4000-8000-000000000009",
      "name": "Normalizar WhatsApp"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3},
                "conditions": [{"id": "cf-wa-text", "leftValue": "={{ $json.mode }}", "rightValue": "text", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "text"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3},
                "conditions": [{"id": "cf-wa-template", "leftValue": "={{ $json.mode }}", "rightValue": "template", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "template"
            }
          ]
        },
        "looseTypeValidation": false,
        "options": {}
      },
