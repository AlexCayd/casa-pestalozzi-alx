        "recipientPhoneNumber": "={{ $json.to }}",
        "template": "={{ $json.template + '|' + $('Configuración').first().json.RESERVATION_WHATSAPP_TEMPLATE_LANGUAGE }}",
        "components": "={{ $json.components }}"
