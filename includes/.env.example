# Copiar a includes/.env local. Nunca versionar credenciales reales.
APP_ENV=development
APP_TIMEZONE=America/Mexico_City
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=cp_dev_casa
# Establecer localmente la contraseña de desarrollo acordada. Sin valor se bloquea el bootstrap.
DEV_SUPERADMIN_PASSWORD=
# Secreto aleatorio local de al menos 32 caracteres para los NIP; no reutilizar en otras instalaciones.
NIP_LOOKUP_SECRET=
N8N_BASE_URL=
N8N_SECRET=
N8N_RESERVATIONS_WEBHOOK_SECRET=
# Llave HS256 con la que n8n firma el JWT de /api/integraciones/* (Bearer). Sin ella esas rutas
# responden 500. Al menos 32 bytes aleatorios, distinta de otros secretos: openssl rand -base64 48
JWT_N8N_ENTRADA_SECRET=
