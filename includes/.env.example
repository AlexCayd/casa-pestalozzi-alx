# Casa Pestalozzi
# Copiar este archivo como includes/.env y reemplazar los valores de ejemplo.
# El archivo real includes/.env no debe versionarse.

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------

APP_ENV=development
# Zona horaria canónica de PHP/DB/n8n. Mantener sincronizada entre servicios.
APP_TIMEZONE=America/Mexico_City

# En development puede apuntar a una carpeta escribible para las
# sesiones PHP. Si queda vacío, la aplicación usa sus fallbacks locales.
SESSION_SAVE_PATH=

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------

DB_HOST=127.0.0.1
DB_USER=casa_pestalozzi
DB_PASS=replace-with-database-password
DB_NAME=casa_pestalozzi

# -----------------------------------------------------------------------------
# Usuarios de piso / NIP
# -----------------------------------------------------------------------------

# Secreto estable por instalación para derivar nip_lookup mediante HMAC.
# Debe ser largo, aleatorio y diferente entre desarrollo y producción.
NIP_LOOKUP_SECRET=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# Reservaciones públicas
# -----------------------------------------------------------------------------

# En producción debe ser la URL pública HTTPS del sitio, sin slash final.
RESERVATION_PUBLIC_BASE_URL=http://localhost

# TTL del acceso temporal por cambio de horario.
# El código limita el valor efectivo a un rango de 15 a 180 minutos.
SCHEDULE_CHANGE_ACCESS_TTL_MINUTES=60

# Datos de contacto mostrados en la experiencia pública.
RESERVAS_TELEFONO_VISIBLE="56 1481 8297"
RESERVAS_TELEFONO_TEL=+525614818297
RESERVAS_WHATSAPP=525614818297

# -----------------------------------------------------------------------------
# Sitio público
# -----------------------------------------------------------------------------

# Estos valores alimentan SitioConfig; se pueden personalizar por instalación.
SITIO_DIRECCION="José Enrique Pestalozzi 1250, Del Valle, CDMX"
SITIO_DIRECCION_CORTA="Pestalozzi 1250, CDMX"
SITIO_CORREO=hola@casapestalozzi.mx
SITIO_MAPS_URL=https://maps.app.goo.gl/NwDmN5Tjbz3Etf7r7
SITIO_INSTAGRAM=https://www.instagram.com/casapestalozzi
# WhatsApp de eventos/catering; es distinto al número de reservaciones.
SITIO_WHATSAPP_EVENTOS=525637185620

# -----------------------------------------------------------------------------
# n8n — flujos ya consumidos por la aplicación
# -----------------------------------------------------------------------------

N8N_WEBHOOK_SUGERENCIAS_URL=http://localhost:5678/webhook/sugerencias
N8N_WEBHOOK_AREAS_MEJORA_URL=http://localhost:5678/webhook/areas-mejora
# Credencial legacy exclusiva de feedback/áreas de mejora; reservaciones no la lee.
N8N_SECRET=

# -----------------------------------------------------------------------------
# n8n — reservaciones / notificaciones
# -----------------------------------------------------------------------------

# APP_ENV decide el transporte: development no llama n8n; test y production sí.
N8N_BASE_URL=http://localhost:5678
# PHP -> n8n. Credencial Header Auth del Webhook: X-N8N-Secret.
N8N_RESERVATIONS_WEBHOOK_SECRET=
# n8n -> PHP. Credencial HTTP Header Auth: X-N8N-Callback-Secret.
# Debe ser diferente de la anterior y de N8N_SECRET/NIP_LOOKUP_SECRET.
N8N_RESERVATIONS_CALLBACK_SECRET=

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
# Sólo se usa cuando APP_ENV=test. Permite fijar el reloj del módulo.
#
# RESERVATION_TEST_NOW=2026-08-22 12:00:00
